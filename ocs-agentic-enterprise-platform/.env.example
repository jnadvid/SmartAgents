# =============================================================
# OCS Agentic Enterprise Platform - Configuración local
# Copia este archivo a .env y ajusta los valores.
# Nunca subas el archivo .env a un repositorio.
# =============================================================

APP_NAME=OCS Agentic Enterprise Platform
APP_ENV=local

# Host y puerto del backend FastAPI
APP_HOST=127.0.0.1
APP_PORT=8000

# Base de datos local SQLite (ruta relativa a la raíz del proyecto)
DATABASE_URL=sqlite:///./backend/data/app.db

# Ollama (proveedor de IA local)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120

# Seguridad
# Si ENABLE_AUTH=true, todas las rutas (excepto /health) exigen
# la cabecera X-API-Key con el valor de SECRET_KEY.
SECRET_KEY=change-me
ENABLE_AUTH=false

# Límites de entrada
MAX_INPUT_CHARS=30000
MAX_DOCUMENT_SIZE_MB=20

# Orquestación
# Usar Ollama para clasificar la intención cuando las reglas no son concluyentes
USE_LLM_INTENT_FALLBACK=true
# Ejecutar agentes auxiliares propuestos por el router (aumenta la latencia)
ENABLE_AUXILIARY_AGENTS=false

# Programador de tareas (scheduler local en proceso)
# Si ENABLE_SCHEDULER=true, un hilo en segundo plano ejecuta las tareas
# programadas (puntuales o periódicas). SCHEDULER_POLL_SECONDS define cada
# cuánto se comprueban las tareas vencidas.
ENABLE_SCHEDULER=true
SCHEDULER_POLL_SECONDS=30

# Conectores de datos (lectura para los agentes)
# Los conectores de archivo (Wazuh local, JSON, CSV) están siempre disponibles y solo
# leen dentro de backend/data. Los conectores HTTP están desactivados por defecto.
ENABLE_HTTP_CONNECTORS=false
# Hosts permitidos para el conector HTTP (coma-separados), p. ej. "localhost,127.0.0.1"
HTTP_CONNECTOR_ALLOWLIST=
# Ruta del alerts.json de Wazuh (vacío = backend/data/connectors/wazuh/alerts.json)
WAZUH_ALERTS_PATH=
CONNECTOR_TIMEOUT=15

# Pentesting con herramientas de Kali (DESACTIVADO por defecto)
# Ejecuta binarios reales (nmap, nikto, nuclei…). Úsalo SOLO sobre objetivos
# de tu propiedad o con autorización explícita. Solo escanea hosts de la
# allow-list de alcance; si está vacía, se rechaza todo.
ENABLE_PENTEST_TOOLS=false
# Dominios (con subdominios), IPs o CIDRs autorizados (coma-separados)
PENTEST_SCOPE_ALLOWLIST=
PENTEST_TIMEOUT=180
PENTEST_MAX_OUTPUT_CHARS=20000
# Entorno de ejecución: native (Linux/Kali del host) | wsl (Windows + Kali)
PENTEST_EXECUTION_MODE=native
PENTEST_WSL_DISTRO=kali-linux
PENTEST_WSL_USER=
PENTEST_WSL_PASSWORD=

# Email / notificaciones (SMTP; para Gmail usa una contraseña de aplicación)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
NOTIFY_EMAIL=

# Nota: estos ajustes (DEFAULT_OLLAMA_MODEL, ENABLE_PENTEST_TOOLS,
# PENTEST_SCOPE_ALLOWLIST/EXECUTION_MODE/WSL_*, y SMTP_*/NOTIFY_EMAIL) también
# se editan desde la web (pestaña Ajustes); el valor de la BD tiene prioridad.
# Las contraseñas se gestionan mejor desde la web (no se devuelven nunca).

# RAG local
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
# RAG semántico (Fase 2): embeddings con Ollama + búsqueda híbrida (keyword + coseno)
RAG_USE_EMBEDDINGS=true
RAG_VECTOR_WEIGHT=0.65

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
LOG_JSON=true
